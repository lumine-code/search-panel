{
  "context-menu": {
    ".tree-view li.directory:not(.tree-view-special-root)": [
      {
        "type": "separator"
      },
      {
        "label": "Search in Folder",
        "command": "search-panel:project-show-in-current-directory",
        "afterGroupContaining": [
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ]
      },
      {
        "type": "separator"
      }
    ],
    ".list-item.match-row": [
      {
        "type": "separator"
      },
      {
        "label": "Open in New Tab",
        "command": "search-panel:open-in-new-tab"
      },
      {
        "label": "Copy",
        "command": "core:copy"
      },
      {
        "label": "Copy Path",
        "command": "search-panel:copy-path"
      },
      {
        "type": "separator"
      }
    ],
    ".list-item.path-row": [
      {
        "type": "separator"
      },
      {
        "label": "Open in New Tab",
        "command": "search-panel:open-in-new-tab"
      },
      {
        "label": "Copy Path",
        "command": "search-panel:copy-path"
      },
      {
        "type": "separator"
      }
    ]
  }
}
